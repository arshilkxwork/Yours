{
  "expo": {
    "name": "Yours",
    "slug": "yours",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "yours",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yours.journal",
      "infoPlist": {
        "NSCameraUsageDescription": "Yours uses your camera to capture photos and notes.",
        "NSMicrophoneUsageDescription": "Yours uses your microphone for voice memos.",
        "NSPhotoLibraryUsageDescription": "Yours accesses your photo library to save memories.",
        "NSPhotoLibraryAddUsageDescription": "Yours saves photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFF8F3"
      },
      "package": "com.yours.journal",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F3"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#D9A3B4",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Yours to access your camera for photos and video calls."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Yours to access your photos to share memories.",
          "cameraPermission": "Allow Yours to use your camera."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Yours to access your microphone for voice messages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
